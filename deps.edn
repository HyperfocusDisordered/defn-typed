{:paths ["src" "resources"]
 ;; oldest malli every suite passes on: 0.16.3 (README "malli versions")
 :deps {metosin/malli {:mvn/version "0.20.1"}}
 :aliases {;; clj tests: clojure -M:test (-Ddefn-typed.dev=true: the dev behaviour under test, as a
           ;; project's dev/test alias sets it)
           :test {:extra-paths ["test"]
                  :jvm-opts ["-Ddefn-typed.dev=true"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               ;; core_test.clj runs the exported clj-kondo hooks in process (hook-findings)
                               clj-kondo/clj-kondo {:mvn/version "2026.01.19"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
           ;; Typed Clojure bridge tests: clojure -M:typed (defn-typed.typed-clojure + the checker;
           ;; the default :test run never loads Typed Clojure); the green-fingerprint cache off, so every
           ;; check a test counts runs (typed_check_greens_test switches it on with a temp file)
           :typed {:extra-paths ["test-typed"]
                   :jvm-opts ["-Ddefn-typed.dev=true" "-Ddefn-typed.typed-check-cache=off"]
                   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                                org.typedclojure/typed.clj.checker {:mvn/version "1.3.0"}
                                org.typedclojure/typed.malli {:mvn/version "1.3.0"}}
                   :main-opts ["-m" "cognitect.test-runner" "-d" "test-typed"]}
           ;; cljs tests: clojure -M:cljs compile test (shadow-cljs :node-test, runs under node)
           :cljs {:extra-paths ["test"]
                  :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.23"}}
                  :main-opts ["-m" "shadow.cljs.devtools.cli"]}
           ;; release: clojure -T:build jar | deploy (see build.clj)
           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}}}
